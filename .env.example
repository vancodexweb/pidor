# Token of the MAIN constructor bot, obtained from @BotFather.
MAIN_BOT_TOKEN=

# PostgreSQL credentials — used both by the postgres container and by the
# app to build its connection string. Keep these in sync with each other
# (docker-compose passes the same values to the postgres service).
POSTGRES_USER=bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Fernet key used to encrypt child bot tokens at rest. Generate one with:
#   docker compose run --rm app python -c "from app.core.security import generate_encryption_key; print(generate_encryption_key())"
# Keep this secret and never change it after bots have been connected —
# doing so makes existing stored tokens undecryptable.
ENCRYPTION_KEY=

LOG_LEVEL=INFO

# Default timezone used for a brand-new child bot until its owner changes it.
DEFAULT_TIMEZONE=Europe/Moscow
